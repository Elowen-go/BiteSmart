page { min-height:100vh; background:#F3F0E9; }.setup-page { padding:100rpx 48rpx 70rpx; }.setup-kicker { color:#7C897F; font-size:19rpx; letter-spacing:4rpx; }.wordmark { color:#153F32; font-size:34rpx; font-weight:800; margin-top:20rpx; }.wordmark text { color:#E15D45; }.title { display:block; color:#18362B; font-size:46rpx; font-weight:700; line-height:1.4; margin-top:70rpx; }.subtitle { display:block; color:#7C897F; font-size:23rpx; line-height:1.7; margin:24rpx 0 54rpx; }.field { padding:20rpx 0 14rpx; border-bottom:1rpx solid #C8CEC7; margin-bottom:20rpx; }.field text { display:block; color:#65736A; font-size:19rpx; letter-spacing:1rpx; }.field input { height:54rpx; color:#18362B; font-size:27rpx; }.submit-button { display:flex; justify-content:space-between; align-items:center; height:92rpx; margin-top:56rpx; padding:0 26rpx; color:#fff; background:#153F32; text-align:left; font-size:27rpx; }.submit-button text { font-size:36rpx; }.error-message { display:block; color:#B9483D; font-size:22rpx; margin-top:20rpx; }
