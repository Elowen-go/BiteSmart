<view class="pg" style="padding-top: {{padTop}}px;">
  <view class="head">
    <view class="en">ACCOUNT SETUP</view>
    <view class="t">完善账号信息</view>
    <view class="s">设置用户名与手机号，便于找回账号与接收配送通知</view>
  </view>

  <view class="card form-card">
    <view class="form-row">
      <view class="f-lab">用户名 <text class="req">*</text></view>
      <input class="f-input" placeholder="给自己起个名字" placeholder-class="ph-txt" value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="f-lab">手机号 <text class="req">*</text></view>
      <input class="f-input" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph-txt" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="f-lab">登录密码 <text class="req">*</text></view>
      <input class="f-input" password placeholder="设置登录密码" placeholder-class="ph-txt" value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="err">{{errorMessage}}</view>

  <view class="btn-ink green submit {{loading ? 'disabled' : ''}}" bindtap="submit" hover-class="tap">{{loading ? '保存中…' : '完成，开始使用'}}</view>
</view>
