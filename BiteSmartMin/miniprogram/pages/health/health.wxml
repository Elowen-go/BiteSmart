<view class="user-page"><view class="back-row"><text class="back" bindtap="back">‹</text><text>健康记录</text><text class="accent">今天</text></view><text class="eyebrow">YOUR DAILY RHYTHM</text><text class="title">记录每一个小变化。</text><view class="health-grid"><view class="health-card purple"><text>饮食</text><text class="health-value">0</text><text>今日 kcal</text><button data-label="添加饮食记录" bindtap="action">+ 添加</button></view><view class="health-card blue"><text>运动</text><text class="health-value">0</text><text>今日 kcal</text><button data-label="添加运动记录" bindtap="action">+ 添加</button></view><view class="health-card green"><text>饮水</text><text class="health-value">1500</text><text>目标 ml</text><button data-label="记录饮水" bindtap="action">+ 添加</button></view><view class="health-card peach"><text>体重</text><text class="health-value">60.0</text><text>kg</text><button data-label="记录体重" bindtap="action">+ 添加</button></view></view><view class="panel"><text class="panel-title">近 7 天体重趋势</text><view wx:if="{{hasWeightHistory}}" class="trend-list"><block wx:for="{{weightRecords}}" wx:key="recordDate"><view><text>{{item.recordDate}}</text><text>{{item.weight}} kg</text></view></block></view><view wx:else class="line-empty" data-label="记录体重" bindtap="action"><text>暂无足够体重记录</text><text>至少记录两次后查看趋势 〉</text></view><text class="panel-note">{{hasWeightHistory ? '以上为近 7 天真实记录。' : '记录几次体重后，这里会显示你的变化趋势。'}}</text></view></view>
