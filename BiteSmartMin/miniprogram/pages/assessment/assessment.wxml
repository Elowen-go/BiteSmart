<view class="pg">
  <!-- 自定义导航（margin-top = 胶囊 top，高度 = 胶囊高度，与胶囊同行对齐） -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="goBack" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">健康档案</view>
    <view class="nav-ph"></view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 分步进度 -->
    <view class="steps">
      <block wx:for="{{stepLabels}}" wx:key="*this">
        <view class="st-node {{index < step ? 'done' : (index === step ? 'on' : '')}}">
          <view class="st-dot">
            <text wx:if="{{index < step}}" class="st-ck">✓</text>
            <view wx:else class="st-inner"></view>
          </view>
          <text class="st-lab">{{item}}</text>
        </view>
        <view wx:if="{{index < stepLabels.length - 1}}" class="st-line {{index < step ? 'done' : ''}}"></view>
      </block>
    </view>

    <!-- 第 1 步：目标设定 -->
    <block wx:if="{{step === 0}}">
      <view class="asm-q">你的目标是</view>
      <view class="asm-sub">AI 将以此确定每日热量预算与营养结构</view>
      <view class="opt {{goal === item.n ? 'on' : ''}}" wx:for="{{goals}}" wx:key="n" bindtap="pickGoal" data-v="{{item.n}}" hover-class="tap">
        <image class="ph" src="{{item.image}}" mode="aspectFill" />
        <view class="opt-main">
          <view class="opt-name">{{item.n}}</view>
          <view class="opt-desc">{{item.d}}</view>
        </view>
        <view class="ck-c"><text wx:if="{{goal === item.n}}" class="ck-t">✓</text></view>
      </view>
    </block>

    <!-- 第 2 步：想改善的部位 -->
    <block wx:if="{{step === 1}}">
      <view class="asm-q">想改善的部位</view>
      <view class="asm-sub">可多选，人体模型会同步高亮所选部位</view>
      <view class="part-chips">
        <view class="chip {{parts.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{partList}}" wx:key="*this" bindtap="togglePart" data-v="{{item}}">{{item}}</view>
      </view>
      <view class="bodymap">
        <view class="fig">
          <view class="fig-box">
            <image class="fig-img" src="/assets/body/base-front.png" mode="aspectFit" />
            <image class="fig-img overlay" wx:for="{{frontOverlays}}" wx:key="*this" src="{{item}}" mode="aspectFit" />
          </view>
          <text class="fig-lab">正面</text>
        </view>
        <view class="fig">
          <view class="fig-box">
            <image class="fig-img" src="/assets/body/base-back.png" mode="aspectFit" />
            <image class="fig-img overlay" wx:for="{{backOverlays}}" wx:key="*this" src="{{item}}" mode="aspectFit" />
          </view>
          <text class="fig-lab">背面</text>
        </view>
      </view>
    </block>

    <!-- 第 3 步：运动量 -->
    <block wx:if="{{step === 2}}">
      <view class="asm-q">每周的运动量</view>
      <view class="asm-sub asm-sub-line">AI 会根据运动量计算每日总能量消耗（TDEE），用于精准定制食谱与运动计划</view>
      <view class="opt {{activity === item.n ? 'on' : ''}}" wx:for="{{acts}}" wx:key="n" bindtap="pickActivity" data-v="{{item.n}}" hover-class="tap">
        <image class="ph" src="{{item.image}}" mode="aspectFill" />
        <view class="opt-main">
          <view class="opt-name">{{item.n}}</view>
          <view class="opt-desc">{{item.d}}</view>
        </view>
        <view class="ck-c"><text wx:if="{{activity === item.n}}" class="ck-t">✓</text></view>
      </view>
      <view class="f-lab" style="margin-top: 24rpx;">每周运动次数</view>
      <view class="part-chips">
        <view class="chip {{freq === item ? 'on' : ''}}" wx:for="{{freqs}}" wx:key="*this" bindtap="pickFreq" data-v="{{item}}">{{item}}</view>
      </view>
    </block>

    <!-- 第 4 步：身体档案 -->
    <block wx:if="{{step === 3}}">
      <view class="asm-q">身体与饮食档案</view>
      <view class="asm-sub">最后一步，让食谱真正适合你</view>

      <view class="form-row">
        <view class="f-lab">性别</view>
        <view class="part-chips">
          <view class="chip {{gender === '男' ? 'on' : ''}}" bindtap="pickGender" data-v="男">男</view>
          <view class="chip {{gender === '女' ? 'on' : ''}}" bindtap="pickGender" data-v="女">女</view>
        </view>
      </view>

      <view class="form-row">
        <view class="f-lab">年龄 / 身高 / 体重 <text class="req">*</text></view>
        <view class="input-3">
          <input class="f-input" type="number" value="{{age}}" placeholder="年龄" data-field="age" bindinput="onFieldInput" />
          <input class="f-input" type="number" value="{{height}}" placeholder="身高 cm" data-field="height" bindinput="onFieldInput" />
          <input class="f-input" type="digit" value="{{weight}}" placeholder="体重 kg" data-field="weight" bindinput="onFieldInput" />
        </view>
      </view>

      <view class="form-row">
        <view class="f-lab">目标体重 kg <text class="req">*</text>（30 - 200）</view>
        <input class="f-input" type="digit" value="{{targetWeight}}" placeholder="例如：70" data-field="targetWeight" bindinput="onFieldInput" />
      </view>

      <view class="form-row">
        <view class="f-lab">饮食偏好（可多选）</view>
        <view class="part-chips">
          <view class="chip {{prefs.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{prefList}}" wx:key="*this" bindtap="togglePref" data-v="{{item}}">{{item}}</view>
        </view>
      </view>

      <view class="form-row">
        <view class="f-lab">忌口 / 过敏（可多选）</view>
        <view class="part-chips">
          <view class="chip {{avoid.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{avoidList}}" wx:key="*this" bindtap="toggleAvoid" data-v="{{item}}">{{item}}</view>
        </view>
      </view>

      <view class="form-err" wx:if="{{err}}">{{err}}</view>
    </block>

    <view style="height: 180rpx;"></view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="asm-foot">
    <view wx:if="{{step > 0}}" class="btn-ink ghost foot-btn" bindtap="goBack" hover-class="tap">上一步</view>
    <view class="btn-ink foot-btn main" bindtap="next" hover-class="tap">{{step === 3 ? '生成专属计划' : '下一步'}}</view>
  </view>
</view>
