<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="back" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">AI 营养师</view>
    <view class="nav-r">
      <view class="nav-action" bindtap="startNewChat">新对话</view>
      <view class="nav-action" bindtap="openHistory">历史</view>
      <view class="online"></view>
    </view>
  </view>

  <!-- 消息区 -->
  <scroll-view class="msgs" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{toView}}" scroll-with-animation="true">
    <view class="day-tag">今天</view>

    <!-- 欢迎语 -->
    <view class="b-row">
      <view class="avt">AI</view>
      <view class="bub ai">你好，我是你的 AI 营养师。可以问我今天怎么吃、蛋白质够不够，或者让我帮你配一周餐单。</view>
    </view>

    <!-- 历史与对话 -->
    <view wx:for="{{messages}}" wx:key="index" id="m{{index}}">
      <view class="b-row me-row" wx:if="{{item.question}}">
        <view class="bub me">{{item.question}}</view>
      </view>
      <view class="b-row" wx:if="{{item.answer}}">
        <view class="avt">AI</view>
        <view class="ai-message-stack">
          <view class="bub ai"><text class="ai-answer">{{item.formattedAnswer}}</text></view>
          <scroll-view wx:if="{{item.dishCards.length}}" class="ai-dish-row" scroll-x enhanced show-scrollbar="{{false}}">
            <view wx:for="{{item.dishCards}}" wx:key="id" class="ai-dish-card">
              <image class="ai-dish-image" src="{{item.image}}" mode="aspectFill" />
              <view class="ai-dish-body">
                <text class="ai-dish-name">{{item.name}}</text>
                <text class="ai-dish-meta">{{item.calories}} kcal · 蛋白质 {{item.protein}}g</text>
                <view class="ai-dish-foot"><text class="ai-dish-price">¥{{item.price}}</text><view class="ai-dish-add" catchtap="addRecommendedDish" data-id="{{item.id}}">+</view></view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <!-- typing -->
    <view class="b-row" wx:if="{{loading && !streamingAnswer}}">
      <view class="avt">AI</view>
      <view class="bub ai typing"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
    </view>

    <!-- 快捷问题 -->
    <view class="sugs" wx:if="{{messages.length <= 1}}">
      <text class="q" wx:for="{{suggestions}}" wx:key="*this" bindtap="useSuggestion" data-question="{{item}}" hover-class="tap">{{item}}</text>
    </view>

    <view class="foot-space"></view>
  </scroll-view>

  <view wx:if="{{historyOpen}}" class="history-mask" catchtap="closeHistory">
    <view class="history-panel" catchtap="noop">
      <view class="history-head"><text>历史对话</text><text class="history-close" bindtap="closeHistory">×</text></view>
      <scroll-view class="history-list" scroll-y>
        <view wx:if="{{!sessions.length}}" class="history-empty">暂无历史对话</view>
        <view wx:for="{{sessions}}" wx:key="sessionId" class="history-item" bindtap="selectHistory" data-session-id="{{item.sessionId}}">
          <text class="history-title">{{item.title}}</text>
          <text class="history-time">{{item.time}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 输入条 -->
  <view class="chat-input">
    <input class="in" value="{{question}}" placeholder="输入你的问题…" placeholder-class="ph-txt" bindinput="onInput" confirm-type="send" bindconfirm="send" adjust-position="{{true}}" cursor-spacing="16" />
    <view class="send {{loading ? 'disabled' : ''}}" bindtap="send" hover-class="tap"><view class="ic-send"></view></view>
  </view>
</view>
