<view class="pg">
  <view class="topbar" style="padding-top: {{padTop}}px;">
    <view class="brand-lockup">
      <view class="ai-mark"><image class="ai-avatar-image" src="/assets/ai/ai-avatar.png" mode="aspectFill" /></view>
      <view class="brand-copy">
        <text class="brand-overline">BITESMART / DAILY CARE</text>
        <text class="brand-title">AI 营养师</text>
      </view>
    </view>
    <view class="top-actions">
      <view class="top-action" bindtap="startNewChat">新对话</view>
      <view class="top-action" bindtap="openHistory">历史</view>
      <view class="status"><view class="status-dot"></view><text>在线</text></view>
    </view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{toView}}" scroll-with-animation="true">
    <view class="welcome">
      <view class="welcome-backdrop">
        <image class="welcome-backdrop-image" src="/assets/ai/ai-character.png" mode="aspectFit" />
      </view>
      <view class="welcome-main">
        <text class="welcome-title">今天想聊点什么？</text>
        <text class="welcome-copy">从一餐开始，找到适合你的答案。</text>
      </view>
      <view class="welcome-side">
        <image class="welcome-character" src="/assets/ai/ai-character.png" mode="aspectFit" />
      </view>
    </view>

    <view class="prompt-section">
      <view class="section-heading">
        <text class="section-title">你可以问我</text>
      </view>
      <view class="prompt-list">
        <view class="prompt-item" wx:for="{{suggestions}}" wx:key="*this" bindtap="useSuggestion" data-question="{{item}}" hover-class="tap">
          <text class="prompt-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="recommend-section">
      <view class="recommend-heading">
        <text class="recommend-title">AI 今日推荐</text>
        <view class="recommend-more" bindtap="goFood" hover-class="tap"><text>查看全部</text><text>›</text></view>
      </view>
      <scroll-view class="recommend-row" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id">
          <view class="recommend-media" bindtap="openRecommendation" data-id="{{item.id}}" hover-class="tap">
            <image class="recommend-img" src="{{item.image}}" mode="aspectFill" lazy-load="true" />
          </view>
          <view class="recommend-card-body">
            <text class="recommend-name">{{item.name}}</text>
            <view class="recommend-card-foot">
              <text class="recommend-kcal">{{item.calories}} kcal</text>
              <view class="recommend-add" catchtap="addRecommendation" data-id="{{item.id}}" hover-class="tap"><text>+</text></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="day-label" wx:if="{{messages.length > 0}}">今天</view>

    <block wx:for="{{messages}}" wx:key="index" id="m{{index}}">
      <view class="message-row me-row" wx:if="{{item.question}}">
        <view class="bubble me-bubble">{{item.question}}</view>
        <view class="user-avatar">
          <image wx:if="{{avatar}}" class="user-avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError" />
          <text wx:else>{{initial}}</text>
        </view>
      </view>
      <view class="message-row" wx:if="{{item.answer}}">
        <view class="message-avatar"><image class="ai-avatar-image" src="/assets/ai/ai-avatar.png" mode="aspectFill" /></view>
        <view class="ai-message-stack">
          <view class="bubble ai-bubble"><text class="ai-answer">{{item.formattedAnswer}}</text></view>
          <scroll-view wx:if="{{item.dishCards.length}}" class="ai-dish-row" scroll-x enhanced show-scrollbar="{{false}}">
            <view wx:for="{{item.dishCards}}" wx:key="id" class="ai-dish-card">
              <image class="ai-dish-image" src="{{item.image}}" mode="aspectFill" />
              <view class="ai-dish-body">
                <text class="ai-dish-name">{{item.name}}</text>
                <text class="ai-dish-meta">{{item.calories}} kcal · 蛋白质 {{item.protein}}g</text>
                <view class="ai-dish-foot"><text class="ai-dish-price">¥{{item.price}}</text><view class="ai-dish-add" catchtap="addRecommendedDish" data-id="{{item.id}}">+</view></view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    <view class="message-row" wx:if="{{loading && !streamingAnswer}}">
      <view class="message-avatar"><image class="ai-avatar-image" src="/assets/ai/ai-avatar.png" mode="aspectFill" /></view>
      <view class="bubble ai-bubble typing"><text class="dot"></text><text class="dot"></text><text class="dot"></text></view>
    </view>

    <view class="foot-space"></view>
  </scroll-view>

  <view wx:if="{{historyOpen}}" class="history-mask" catchtap="closeHistory">
    <view class="history-panel" catchtap="noop">
      <view class="history-head"><text>历史对话</text><text class="history-close" bindtap="closeHistory">×</text></view>
      <scroll-view class="history-list" scroll-y>
        <view wx:if="{{!sessions.length}}" class="history-empty">暂无历史对话</view>
        <view wx:for="{{sessions}}" wx:key="sessionId" class="history-item" bindtap="selectHistory" data-session-id="{{item.sessionId}}">
          <text class="history-title">{{item.title}}</text>
          <text class="history-time">{{item.time}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="composer">
    <view class="composer-inner">
      <input class="composer-input" value="{{question}}" placeholder="问问你的饮食计划..." placeholder-class="composer-placeholder" bindinput="onInput" confirm-type="send" bindconfirm="send" adjust-position="{{true}}" cursor-spacing="16" />
      <view class="send-button {{loading ? 'disabled' : ''}}" bindtap="send" hover-class="tap"><view class="ic-send"></view></view>
    </view>
  </view>
</view>
