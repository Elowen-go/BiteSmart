<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="back" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">会员中心</view>
    <view class="nav-ph"></view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- PRO 状态卡 -->
    <view class="vip-hero">
      <view class="lv">BITESMART PRO</view>
      <view class="h3">{{isVip ? 'PRO ' + (typeText || '会员') + '生效中' : '开通 PRO 会员'}}</view>
      <view class="exp">{{isVip ? (expire ? '有效期至 ' + expire : '尊享全部会员权益') : '解锁免配送费与专属餐单'}}</view>
    </view>

    <!-- 会员权益 -->
    <view class="sec"><text class="en">BENEFITS</text><text class="cn">会员权益</text><view class="line"></view></view>
    <view class="card bn-card">
      <view class="benefit" wx:for="{{benefits}}" wx:key="t">
        <view class="bic">{{item.ic}}</view>
        <view class="bm">
          <b>{{item.t}}</b>
          <span>{{item.s}}</span>
        </view>
      </view>
    </view>

    <!-- 套餐 -->
    <view class="sec"><text class="en">PLANS</text><text class="cn">{{isVip ? '续费套餐' : '开通套餐'}}</text><view class="line"></view></view>
    <view class="vip-plan {{item.best ? 'best' : ''}}" wx:for="{{plans}}" wx:key="id" bindtap="buy" data-id="{{item.id}}" hover-class="tap">
      <view class="best-tag" wx:if="{{item.best}}">最划算</view>
      <view class="per">{{item.name}}<span>{{item.days || 'PRO 全部权益'}}</span></view>
      <view class="pr"><b>¥{{item.price}}</b><span wx:if="{{item.org}}">¥{{item.org}}</span></view>
    </view>

    <view class="empty" wx:if="{{!plans.length}}">
      <view class="t">套餐加载中</view>
      <view class="s">稍候片刻，或下拉重新进入</view>
    </view>

    <view class="foot-space"></view>
  </scroll-view>
</view>
