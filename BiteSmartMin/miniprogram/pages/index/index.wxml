<view class="pg">
  <view class="status-pad" style="height: {{padTop}}px;"></view>

  <!-- 日期行 -->
  <view class="h-date">{{dateLine}}</view>

  <!-- 问候行 + 铃铛 -->
  <view class="h-top">
    <view class="h-hello">{{greeting}}，{{nickname}}<text class="sub">继续加油</text></view>
    <view class="icon-btn" bindtap="goNotice" hover-class="tap">
      <view class="ic-bell"><view class="dome"></view><view class="bar"></view><view class="clap"></view></view>
      <view class="unread"></view>
    </view>
  </view>

  <!-- 今日热量卡 -->
  <view class="health card" bindtap="goHealth" hover-class="tap">
    <view class="health-head">
      <text class="lab">今日热量 TODAY</text>
      <text class="rest">还可摄入 {{rest}} kcal</text>
    </view>
    <view class="health-mid">
      <view class="ring-css" style="background: conic-gradient(#1E9E62 {{ringDeg}}deg, #EFF1EC 0deg);">
        <view class="ring-css-inner">
          <text class="num">{{eaten}}</text>
          <text class="unit">/ {{target}} kcal</text>
        </view>
      </view>
      <view class="macros">
        <view class="macro" wx:for="{{macros}}" wx:key="key">
          <view class="m-top">
            <text class="m-lab">{{item.label}} {{item.en}}</text>
            <text class="m-val">{{item.cur}} / {{item.goal}}g</text>
          </view>
          <view class="track"><view class="fill" style="width: {{item.pct}}%; background: {{item.color}};"></view></view>
        </view>
      </view>
    </view>
    <view class="health-foot">
      <text>早餐 <text class="b">{{breakfast}}</text></text>
      <text>午餐 <text class="b">{{lunch}}</text></text>
      <text>加餐 <text class="b">{{snack}}</text></text>
      <text class="burn">运动消耗 <text class="b">-{{exerciseBurn}}</text></text>
    </view>
  </view>

  <!-- AI 今日餐单 -->
  <view class="card plan">
    <view class="plan-head" bindtap="goAi" hover-class="tap">
      <view class="spark-box"><view class="ic-spark"></view></view>
      <view class="plan-t">
        <view class="t">AI 今日餐单</view>
        <view class="s">{{planSub}}</view>
      </view>
      <view class="go" catchtap="goAssessment">定制</view>
    </view>
    <view class="meal {{item.hot ? 'hot' : ''}}" wx:for="{{meals}}" wx:key="when" bindtap="goPlan" hover-class="tap">
      <view class="when">
        <text class="w">{{item.when}}</text>
        <text class="e">{{item.en}}</text>
      </view>
      <view class="what">
        <view class="n">{{item.name}}</view>
        <view class="s">{{item.status}}</view>
      </view>
      <text class="kcal">{{item.kcal}} kcal</text>
    </view>
  </view>

  <!-- 为你推荐 -->
  <view class="sec">
    <text class="en">RECOMMENDED</text>
    <text class="cn">为你推荐</text>
    <view class="line"></view>
    <text class="more" bindtap="goMall">全部</text>
  </view>
  <scroll-view class="rec-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="rec-card" wx:for="{{recs}}" wx:key="id">
      <view class="ph" bindtap="openDish" data-id="{{item.id}}" hover-class="tap">
        <image src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="badge"><view class="flame"></view>{{item.kcal}} kcal</view>
      </view>
      <view class="nm" bindtap="openDish" data-id="{{item.id}}">{{item.name}}</view>
      <view class="sub">{{item.tags}}</view>
      <view class="row">
        <view class="price"><text class="cur">¥</text>{{item.price}}</view>
        <view class="addbtn" catchtap="addDish" data-id="{{item.id}}"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 健康套餐 -->
  <view class="sec">
    <text class="en">WEEKLY PLAN</text>
    <text class="cn">健康套餐</text>
    <view class="line"></view>
    <text class="more" bindtap="goMall">全部</text>
  </view>
  <view class="combo-hero" bindtap="openCombo" hover-class="tap">
    <image src="{{combo.image}}" mode="aspectFill" lazy-load />
    <view class="mask"></view>
    <view class="txt">
      <text class="en">{{combo.en}}</text>
      <text class="t">{{combo.name}}</text>
      <text class="d">{{combo.desc}}</text>
      <text class="lk">查看套餐 ¥{{combo.price}}</text>
    </view>
  </view>

  <view style="height: 32rpx;"></view>
</view>
