<view class="pg">
  <!-- 顶部图片氛围区 -->
  <view class="hero">
    <swiper class="hero-swiper" autoplay circular interval="3600" duration="520">
      <swiper-item wx:for="{{heroBanners}}" wx:key="*this">
        <image class="hero-image" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view class="hero-shade"></view>
    <view class="hero-top" style="padding-top: {{padTop}}px;">
      <view class="hero-copy">
        <view class="h-date">{{dateLine}}</view>
        <view class="h-hello">{{greeting}}，{{nickname}}</view>
        <view class="h-sub">今天也用一餐照顾好自己</view>
      </view>
      <view class="icon-btn hero-bell" bindtap="goNotice" hover-class="tap">
        <view class="ic-bell"><view class="dome"></view><view class="bar"></view><view class="clap"></view></view>
        <view wx:if="{{hasUnreadNotice}}" class="unread"></view>
      </view>
    </view>
  </view>

  <view class="content">
    <!-- 今日健康浮层 -->
    <view class="health card" bindtap="goHealth" hover-class="tap">
      <view class="health-user">
        <view class="avatar-mini">{{initial}}</view>
        <view class="health-name">
          <view class="name-line">
            <text>Hi，{{nickname}}</text>
            <text class="member-pill">智能膳食中</text>
          </view>
          <view class="goal-line">今日目标 {{target}} kcal · 还可摄入 {{rest}} kcal</view>
        </view>
        <view class="health-code">
          <image class="health-file-icon" src="/assets/home/health-profile-user.png" mode="aspectFit" />
          <text>健康档案</text>
        </view>
      </view>

      <view class="health-nums">
        <view class="hn">
          <text class="hn-l">已摄入</text>
          <view class="hn-v">{{eaten}}<text>kcal</text></view>
        </view>
        <view class="hn">
          <text class="hn-l">早餐</text>
          <view class="hn-v">{{breakfast}}<text>kcal</text></view>
        </view>
        <view class="hn">
          <text class="hn-l">午餐</text>
          <view class="hn-v">{{lunch}}<text>kcal</text></view>
        </view>
        <view class="hn burn">
          <text class="hn-l">运动消耗</text>
          <view class="hn-v">-{{exerciseBurn}}<text>kcal</text></view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-row">
      <view class="quick-card" bindtap="goHealth" hover-class="tap">
        <image class="quick-img" src="/assets/quick/quick-record.png" mode="aspectFit" />
        <text>记录</text>
      </view>
      <view class="quick-card" bindtap="goPlan" hover-class="tap">
        <image class="quick-img" src="/assets/quick/quick-plan.png" mode="aspectFit" />
        <text>食谱</text>
      </view>
      <view class="quick-card" bindtap="goMall" hover-class="tap">
        <image class="quick-img" src="/assets/quick/quick-order.png" mode="aspectFit" />
        <text>点餐</text>
      </view>
      <view class="quick-card" bindtap="goAi" hover-class="tap">
        <image class="quick-img" src="/assets/quick/quick-ai.png" mode="aspectFit" />
        <text>问 AI</text>
      </view>
    </view>

  <!-- AI 今日餐单 -->
  <view class="card plan">
    <view class="plan-banner" bindtap="goPlan" hover-class="tap">
      <view class="plan-title">今日三餐</view>
      <view class="plan-energy">
        <text class="plan-energy-num">{{planKcalTotal}}</text>
        <text class="plan-energy-unit">kcal</text>
        <text class="plan-energy-label">今日能量安排</text>
      </view>
      <view class="plan-banner-side">
        <text class="plan-day">{{planDayLabel}}</text>
        <view class="plan-action" catchtap="goAssessment"><text>{{planAction}}</text><text class="plan-arrow">›</text></view>
      </view>
      <view class="plan-collage">
        <block wx:for="{{meals}}" wx:key="when">
          <image wx:if="{{index < 3}}" class="plan-food plan-food-{{index}}" src="{{item.image}}" mode="aspectFill" />
        </block>
      </view>
      <view class="plan-progress plan-banner-progress">
        <view class="plan-progress-copy">
          <text class="plan-progress-title">今日餐单进度</text>
          <text class="plan-progress-value">{{planDoneCount}} / {{planTotal}} 餐已完成</text>
        </view>
        <view class="plan-steps">
          <block wx:for="{{meals}}" wx:key="when">
            <view class="plan-step-item">
              <text class="plan-step-label">{{item.when}}</text>
              <view class="plan-step-track">
                <view class="plan-step-dot {{item.done ? 'done' : ''}}"></view>
                <view wx:if="{{item.hasNext}}" class="plan-step-link {{item.done ? 'done' : ''}}"></view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
    <view class="plan-meals">
      <block wx:for="{{meals}}" wx:key="when">
        <view class="meal meal-{{index}} {{item.hot ? 'is-featured' : ''}}" bindtap="goPlan" hover-class="tap">
          <view class="meal-hooks">
            <view class="meal-hook meal-hook-left"></view>
            <view class="meal-hook meal-hook-right"></view>
          </view>
          <image class="meal-image" src="{{item.image}}" mode="aspectFill" />
          <view class="what">
            <view class="meal-meta"><text class="meal-label">{{item.when}}</text></view>
            <view class="n">{{item.name}}</view>
            <view class="s meal-status {{item.done ? 'is-done' : ''}}"><view class="meal-status-dot"></view><text>{{item.status}}</text></view>
          </view>
          <view class="kcal"><text class="kcal-num">{{item.kcal}}</text><text class="kcal-unit">kcal</text></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 为你推荐 -->
  <view class="sec">
    <text class="en">RECOMMENDED</text>
    <text class="cn">为你推荐</text>
    <view class="line"></view>
    <text class="more" bindtap="goMall">全部</text>
  </view>
  <scroll-view class="rec-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="rec-card" wx:for="{{recs}}" wx:key="id">
      <view class="ph" bindtap="openDish" data-id="{{item.id}}" hover-class="tap">
        <image src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="badge"><view class="flame"></view>{{item.kcal}} kcal</view>
      </view>
      <view class="nm" bindtap="openDish" data-id="{{item.id}}">{{item.name}}</view>
      <view class="sub">{{item.tags}}</view>
      <view class="row">
        <view class="price"><text class="cur">¥</text>{{item.price}}</view>
        <view class="addbtn" catchtap="addDish" data-id="{{item.id}}"><text>加入</text></view>
      </view>
    </view>
  </scroll-view>

  <!-- 健康套餐 -->
  <view class="sec">
    <text class="en">WEEKLY PLAN</text>
    <text class="cn">健康套餐</text>
    <view class="line"></view>
    <text class="more" bindtap="goMall">全部</text>
  </view>
  <view class="combo-hero" bindtap="openCombo" hover-class="tap">
    <image src="{{combo.image}}" mode="aspectFill" lazy-load />
    <view class="mask"></view>
    <view class="txt">
      <text class="en">{{combo.en}}</text>
      <text class="t">{{combo.name}}</text>
      <text class="d">{{combo.desc}}</text>
      <text class="lk">查看套餐 ¥{{combo.price}}</text>
    </view>
  </view>

  <view style="height: 32rpx;"></view>
  </view>
</view>
