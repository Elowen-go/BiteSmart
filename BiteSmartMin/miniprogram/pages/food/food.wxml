<view class="pg">
  <view class="status-pad" style="height: {{padTop}}px;"></view>

  <view class="mall-head">
    <text class="en">SMART MARKET</text>
    <text class="t">今天想吃点什么？</text>
    <text class="s">按目标挑选低卡、高蛋白与健康套餐</text>
  </view>

  <!-- 搜索行 -->
  <view class="searchrow">
    <view class="searchbox">
      <view class="ic-search"></view>
      <input class="kw" placeholder="搜索菜品、套餐、食材" placeholder-class="ph-cls" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <view wx:if="{{keyword}}" class="clr" bindtap="clearSearch">×</view>
    </view>
    <view class="filterbtn" hover-class="tap">
      <view class="f-lines"><view class="l1"></view><view class="l2"></view><view class="l3"></view></view>
    </view>
  </view>

  <!-- 分类 tab -->
  <scroll-view class="cats" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{cats}}"
      wx:key="k"
      class="cat {{cat === item.k ? 'on' : ''}}"
      data-k="{{item.k}}"
      bindtap="setCat"
    >{{item.t}}</view>
  </scroll-view>

  <!-- 排序行 -->
  <view class="sortrow">
    <view class="sort-left">
      <text class="{{sort === 'default' ? 'on' : ''}}" data-k="default" bindtap="setSort">综合</text>
      <text class="{{sort === 'sales' ? 'on' : ''}}" data-k="sales" bindtap="setSort">销量</text>
      <text class="{{sort === 'priceAsc' || sort === 'priceDesc' ? 'on' : ''}}" data-k="price" bindtap="setSort">价格 {{sort === 'priceAsc' ? '↑' : (sort === 'priceDesc' ? '↓' : '↕')}}</text>
    </view>
    <text class="sort-count">{{filtered.length}} 款</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!filtered.length}}" class="empty">
    <view class="e-circle"><view class="ic-search big"></view></view>
    <view class="e-t">没有找到相关商品</view>
    <view class="e-s">换个关键词试试，比如「鸡胸」「低卡」</view>
  </view>

  <!-- 双列瀑布卡 -->
  <view wx:else class="grid2">
    <view class="g-item" wx:for="{{filtered}}" wx:key="id">
      <view class="ph" data-index="{{index}}" bindtap="openItem" hover-class="tap">
        <image src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="badge">{{item.badge}}</view>
        <view wx:if="{{item.sold}}" class="sold">{{item.sold}} 人点过</view>
        <view wx:if="{{item.kind === 'dish' && item.stock === 0}}" class="soldout">已售罄</view>
      </view>
      <view class="nm" data-index="{{index}}" bindtap="openItem">{{item.name}}</view>
      <view class="tags">
        <text class="g-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="row">
        <view class="price">
          <text class="cur">¥</text>{{item.price}}
          <text wx:if="{{item.org}}" class="org">¥{{item.org}}</text>
        </view>
        <view wx:if="{{item.kind === 'dish' && item.stock === 0}}" class="pill gray">售罄</view>
        <view wx:else class="addbtn" data-index="{{index}}" catchtap="addItem"></view>
      </view>
    </view>
  </view>

  <view style="height: 120rpx;"></view>

  <!-- 购物车悬浮按钮 -->
  <view class="cart-fab" bindtap="openCart" hover-class="tap">
    <view class="ic-bag"><view class="handle"></view><view class="body"></view></view>
  </view>
</view>
