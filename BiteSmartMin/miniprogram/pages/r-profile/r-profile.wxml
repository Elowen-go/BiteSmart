<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="goBack" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">编辑资料</view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="card form-card">
      <view class="form-row">
        <view class="f-lab">姓名 <text class="req">*</text></view>
        <input class="f-input" placeholder="真实姓名" placeholder-class="ph-txt" value="{{realName}}" data-field="realName" bindinput="onInput" />
      </view>
      <view class="form-row">
        <view class="f-lab">联系电话</view>
        <input class="f-input" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph-txt" value="{{phone}}" data-field="phone" bindinput="onInput" />
      </view>
      <view class="form-row">
        <view class="f-lab">车辆类型 <text class="req">*</text></view>
        <picker mode="selector" range="{{vehicleTypes}}" value="{{vehicleIndex}}" bindchange="pickVehicle">
          <view class="f-picker {{vehicleIndex === 0 ? 'placeholder' : ''}}">{{vehicleTypes[vehicleIndex]}}<text class="chev-down">⌄</text></view>
        </picker>
      </view>
      <view class="form-row">
        <view class="f-lab">服务区域</view>
        <input class="f-input" placeholder="例如：大学城、城西片区" placeholder-class="ph-txt" value="{{serviceArea}}" data-field="serviceArea" bindinput="onInput" />
      </view>
    </view>

    <view wx:if="{{err}}" class="form-err">{{err}}</view>
    <view style="height: 160rpx;"></view>
  </scroll-view>

  <!-- 底部提交 -->
  <view class="bbar">
    <view class="btn-ink green bbar-btn {{submitting ? 'disabled' : ''}}" bindtap="submit" hover-class="tap">{{submitting ? '保存中…' : '保存'}}</view>
  </view>
</view>
