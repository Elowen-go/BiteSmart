<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="back" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">{{selectable ? '选择收货地址' : '地址管理'}}</view>
    <view class="nav-ph"></view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 地址卡 -->
    <view class="card addr-card {{selectable ? 'sel-mode' : ''}}" wx:for="{{addresses}}" wx:key="id" bindtap="selectAddress" data-address="{{item}}" hover-class="{{selectable ? 'tap' : ''}}">
      <view class="a-top">
        <text class="pill {{item.addressTag === '家' ? 'green' : 'orange'}}" wx:if="{{item.addressTag}}">{{item.addressTag}}</text>
        <b>{{item.receiverName}}</b>
        <text class="ph">{{item.receiverPhone}}</text>
        <text class="pill dark def" wx:if="{{item.isDefault === 1}}">默认</text>
        <text class="go" wx:if="{{selectable}}">›</text>
      </view>
      <view class="a-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</view>
      <view class="a-ops" wx:if="{{!selectable}}">
        <text catchtap="editAddress" data-id="{{item.id}}">编辑</text>
        <text class="danger" catchtap="removeAddress" data-id="{{item.id}}">删除</text>
      </view>
    </view>

    <!-- 空态 -->
    <view class="empty" wx:if="{{!loading && !addresses.length}}">
      <view class="t">还没有收货地址</view>
      <view class="s">新增一个地址，让餐品准时送达</view>
    </view>

    <view class="foot-space"></view>
  </scroll-view>

  <!-- 底部新增 -->
  <view class="bbar">
    <view class="btn-ink green bbar-btn" bindtap="showForm" hover-class="tap">+ 新增收货地址</view>
  </view>

  <!-- 新增 / 编辑弹层 -->
  <view class="mask" wx:if="{{formVisible}}" bindtap="hideForm"></view>
  <view class="pop {{formVisible ? 'on' : ''}}">
    <view class="pop-h">
      <text class="pop-t">{{editingId ? '编辑地址' : '新增地址'}}</text>
      <text class="pop-x" bindtap="hideForm">×</text>
    </view>
    <view class="pop-bd">
      <view class="form-row">
        <view class="f-lab">联系人 <text class="req">*</text></view>
        <input class="f-input" placeholder="收货人姓名" placeholder-class="ph-txt" value="{{form.receiverName}}" data-field="receiverName" bindinput="onInput" />
      </view>
      <view class="form-row">
        <view class="f-lab">手机号 <text class="req">*</text></view>
        <input class="f-input" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph-txt" value="{{form.receiverPhone}}" data-field="receiverPhone" bindinput="onInput" />
      </view>
      <view class="form-row">
        <view class="f-lab">详细地址 <text class="req">*</text></view>
        <input class="f-input" placeholder="小区 / 大厦 / 门牌号" placeholder-class="ph-txt" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="onInput" />
      </view>
      <view class="btn-ink green save-btn" bindtap="saveAddress" hover-class="tap">保存地址</view>
    </view>
  </view>
</view>
