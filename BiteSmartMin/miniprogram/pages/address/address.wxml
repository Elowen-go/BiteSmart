<view class="user-page"><view class="back-row"><text class="back" bindtap="back">‹</text><text>收货地址</text><text class="accent" data-label="新增收货地址" bindtap="action">新增</text></view><text class="eyebrow">DELIVERY ADDRESS</text><text class="title">把喜欢的食物，<br/>送到你身边。</text><block wx:if="{{addresses.length}}"><block wx:for="{{addresses}}" wx:key="id"><view class="panel address-card"><view class="row"><view class="row-main"><text>{{item.receiverName}} <text wx:if="{{item.isDefault === 1}}" class="default-tag">默认</text></text><text>{{item.receiverPhone}}</text></view><text class="accent">编辑</text></view><text class="address-text">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text></view></block></block><view class="panel" wx:else><text class="empty">暂未获取到地址，点击下方添加</text></view><button class="primary" data-label="新增收货地址" bindtap="action">+ 新增收货地址</button></view>
