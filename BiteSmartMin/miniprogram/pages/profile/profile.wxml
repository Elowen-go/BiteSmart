<view class="pg">
  <!-- 顶部健康生活氛围区 -->
  <view class="profile-hero" style="height: calc(404rpx + {{padTop}}px); --profile-pad: {{padTop}}px;">
    <image class="profile-hero-image" src="/assets/home/profile-hero.jpg" mode="aspectFill" />
    <view class="profile-hero-shade"></view>
    <view class="status-pad" style="height: {{padTop}}px;"></view>
    <view class="profile-hero-brand">BiteSmart · HEALTHY LIVING</view>
    <view class="profile-hero-user">
      <view class="hero-avatar" bindtap="chooseAvatar" hover-class="tap">
        <image wx:if="{{avatar}}" class="hero-avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError" />
        <text wx:else>{{initial}}</text>
        <view class="avatar-edit">更换</view>
      </view>
      <view class="hero-user-info">
        <view class="hero-name">{{nickname}} <text class="hero-vip">{{isVip ? 'PRO 会员' : '开通会员'}}</text></view>
        <view class="hero-goal"><view class="hero-goal-dot"></view>目标：{{goal}}</view>
      </view>
    </view>
    <view class="profile-hero-member" bindtap="goMember" hover-class="tap">
      <view>
        <text class="hero-member-title">BiteSmart PRO</text>
        <text class="hero-member-sub">解锁专属食谱、营养分析与会员优惠</text>
      </view>
      <view class="hero-member-go">成为会员 <text>›</text></view>
    </view>
  </view>

  <!-- 用户信息区 -->
  <view class="me-card">
    <view class="quick-strip">
      <view class="quick" wx:for="{{quicks}}" wx:key="key" data-url="{{item.url}}" bindtap="openMenu" hover-class="tap">
        <view class="quick-ic {{item.key}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 数据速览 -->
  <!-- 功能列表 -->
  <view class="sec">
    <text class="cn">功能服务</text>
    <view class="line"></view>
  </view>
  <view class="card m-group">
    <view
      class="m-row"
      wx:for="{{menus}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="openMenu"
      hover-class="tap"
    >
      <view class="m-ic"><view class="{{item.icon}}"></view></view>
      <text class="m-label">{{item.label}}</text>
      <text wx:if="{{item.hint}}" class="hint">{{item.hint}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout" bindtap="logout" hover-class="tap">退出登录</view>

  <view style="height: 48rpx;"></view>
</view>
