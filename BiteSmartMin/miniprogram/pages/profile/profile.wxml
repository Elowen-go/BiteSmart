<view class="pg">
  <view class="status-pad" style="height: {{padTop}}px;"></view>

  <!-- 用户信息区 -->
  <view class="me-card">
    <view class="me-top">
      <view class="avatar">{{initial}}</view>
      <view class="me-info">
        <view class="nm">
          {{nickname}}
          <text class="vip" bindtap="goMember">{{isVip ? 'PRO 会员' : '开通会员'}}</text>
        </view>
        <view class="goal">
          <view class="goal-dot"></view>
          目标：{{goal}}
        </view>
      </view>
    </view>
    <view class="quick-strip">
      <view class="quick" wx:for="{{quicks}}" wx:key="key" data-url="{{item.url}}" bindtap="openMenu" hover-class="tap">
        <view class="quick-ic {{item.key}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 数据速览 -->
  <view class="me-nums">
    <view class="me-num" wx:for="{{stats}}" wx:key="label">
      <view class="v">{{item.num}}<text class="u">{{item.unit}}</text></view>
      <view class="l">{{item.label}}</view>
    </view>
  </view>

  <view class="member-card" bindtap="goMember" hover-class="tap">
    <view>
      <view class="member-t">BiteSmart PRO</view>
      <view class="member-s">解锁专属食谱、营养分析与会员优惠</view>
    </view>
    <view class="member-go">查看</view>
  </view>

  <!-- 功能列表 -->
  <view class="sec">
    <text class="en">SERVICES</text>
    <text class="cn">功能服务</text>
    <view class="line"></view>
  </view>
  <view class="card m-group">
    <view
      class="m-row"
      wx:for="{{menus}}"
      wx:key="key"
      data-url="{{item.url}}"
      bindtap="openMenu"
      hover-class="tap"
    >
      <view class="m-ic"><view class="{{item.icon}}"></view></view>
      <text class="m-label">{{item.label}}</text>
      <text wx:if="{{item.hint}}" class="hint">{{item.hint}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout" bindtap="logout" hover-class="tap">退出登录</view>

  <view style="height: 48rpx;"></view>
</view>
