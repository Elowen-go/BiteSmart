<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="back" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">我的订单</view>
    <view class="nav-ph"></view>
  </view>

  <!-- 状态筛选 -->
  <view class="o-tabs">
    <view class="o-tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" bindtap="setTab" data-key="{{item.key}}">
      {{item.label}}<text class="u" wx:if="{{item.count > 0 && item.key !== 'all'}}">{{item.count}}</text>
    </view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 订单卡 -->
    <view class="card o-card" wx:for="{{filtered}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}" hover-class="tap">
      <view class="o-head">
        <view class="shop"><view class="shop-dot"></view><text>BiteSmart 健康厨房</text></view>
        <text class="st-tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="o-mid">
        <view class="o-left">
          <view class="o-no">订单 {{item.orderNo || '#' + item.id}}</view>
          <view class="o-preview" wx:if="{{item.firstItem}}">
            <image class="preview-ph" src="{{item.firstItem.image}}" mode="aspectFill" lazy-load="true" />
            <view class="preview-copy">
              <view class="preview-name">{{item.firstItem.name}}</view>
              <view class="preview-qty">{{item.firstItem.qty}}份</view>
            </view>
          </view>
        </view>
        <view class="o-info">
          <view class="amt">¥{{item.amountText}}</view>
          <view class="tm">{{item.timeText}}</view>
        </view>
      </view>
      <view class="o-ops">
        <block wx:if="{{item.group === 'unpaid'}}">
          <view class="op primary" catchtap="openDetail" data-id="{{item.id}}">去支付</view>
        </block>
        <block wx:elif="{{item.group === 'doing'}}">
          <view class="op ghost" catchtap="openDetail" data-id="{{item.id}}">订单详情</view>
          <view class="op primary" catchtap="goDelivery" data-id="{{item.id}}">查看配送</view>
          <view class="op refund" wx:if="{{item.canRefund}}" catchtap="applyRefund" data-id="{{item.id}}">{{item.refundActionText}}</view>
          <view class="op refund disabled" wx:elif="{{item.refundState === 'processing'}}">退款处理中</view>
        </block>
        <block wx:elif="{{item.group === 'done'}}">
          <view class="op ghost" catchtap="rebuy">再次购买</view>
          <view class="op primary" catchtap="goReview" data-id="{{item.id}}">评价</view>
          <view class="op refund" wx:if="{{item.canRefund}}" catchtap="applyRefund" data-id="{{item.id}}">{{item.refundActionText}}</view>
          <view class="op refund disabled" wx:elif="{{item.refundState === 'processing'}}">退款处理中</view>
        </block>
        <block wx:else>
          <view class="op ghost" catchtap="openDetail" data-id="{{item.id}}">订单详情</view>
          <view class="op refund disabled" wx:if="{{item.refundState === 'processing' || item.refundState === 'refunded'}}">{{item.refundActionText}}</view>
        </block>
      </view>
    </view>

    <!-- 空态 -->
    <view class="empty" wx:if="{{!loading && !filtered.length}}">
      <view class="t">暂无相关订单</view>
      <view class="s">换其他状态看看，或去点一份健康餐</view>
    </view>

    <view class="foot-space"></view>
  </scroll-view>
</view>
