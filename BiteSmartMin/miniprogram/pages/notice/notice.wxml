<view class="pg">
  <!-- 自定义导航 -->
  <view class="nav" style="margin-top: {{menuTop}}px; height: {{menuH}}px;">
    <view class="nav-back" bindtap="back" hover-class="tap"><text class="chev">‹</text></view>
    <view class="nav-t">公告与消息</view>
    <view class="nav-ph"></view>
  </view>

  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="card n-card" wx:if="{{notices.length}}">
      <view class="notice-item {{openId === item.id ? 'open' : ''}}" wx:for="{{notices}}" wx:key="id" bindtap="toggle" data-id="{{item.id}}">
        <view class="n-top">
          <b>{{item.title}}</b>
          <text class="n-date">{{item.date}}</text>
        </view>
        <view class="n-body" wx:if="{{openId === item.id}}">{{item.body || '暂无详细内容'}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !notices.length}}">
      <view class="t">暂无公告</view>
      <view class="s">平台通知与活动消息会出现在这里</view>
    </view>

    <view class="foot-space"></view>
  </scroll-view>
</view>
