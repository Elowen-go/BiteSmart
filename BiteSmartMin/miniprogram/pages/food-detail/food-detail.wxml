<view class="food-detail"><image class="detail-image" src="{{item.image}}" mode="aspectFill"/><view class="detail-body"><view class="back-floating" bindtap="back">‹</view><text class="eyebrow">{{item.kcal}}</text><text class="title">{{item.name}}</text><text class="subtitle">{{item.desc}}</text><view class="nutrition"><view><text>蛋白质</text><text>32g</text></view><view><text>脂肪</text><text>12g</text></view><view><text>碳水</text><text>28g</text></view></view><view class="panel"><text class="panel-title">适宜人群</text><text class="panel-note">适合减脂、日常控油和需要补充蛋白质的人群。</text></view><view class="bottom-action"><text class="price">¥{{item.price}}</text><button data-label="加入购物车" bindtap="add">加入购物车</button></view></view></view>
